+	if (mScreenTexture != nullptr &&
+	    (aBufferW != OverhaulPresentation::sBufferW ||
+	     aBufferH != OverhaulPresentation::sBufferH))
+	{
+		SDL_DestroyTexture(mScreenTexture);
+		mScreenTexture = SDL_CreateTexture(mRenderer, SDL_PIXELFORMAT_RGBA8888,
+		                                  SDL_TEXTUREACCESS_TARGET, aBufferW, aBufferH);
+		if (mScreenTexture == nullptr)
+		{
+			std::fprintf(stderr, "[overhaul] screen texture %dx%d failed: %s\n",
+			             aBufferW, aBufferH, SDL_GetError());
+			return;
+		}
+	}
+	OverhaulPresentation::sBufferW = aBufferW;
+	OverhaulPresentation::sBufferH = aBufferH;
+	OverhaulPresentation::sScaleX = (float)aBufferW / (float)mWidth;
+	OverhaulPresentation::sScaleY = (float)aBufferH / (float)mHeight;
+	OverhaulPresentation::sOffsetX = (float)(windowWidth - aBufferW) * 0.5f;
+	OverhaulPresentation::sOffsetY = (float)(windowHeight - aBufferH) * 0.5f;
+
+	mPresentationRect = Rect(0, 0, mWidth, mHeight);
